# Copy to .env and adjust. Never commit .env. The password below is a DEV-ONLY default: change it anywhere else.
POSTGRES_USER=citizen
POSTGRES_PASSWORD=citizen_dev_only
POSTGRES_DB=citizen_news
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Used by the API outside docker compose (compose builds it from the POSTGRES_* values; host is "db" there).
DATABASE_URL=postgresql+psycopg://citizen:citizen_dev_only@localhost:5432/citizen_news
# Minutes between two ingestion + clustering cycles of the worker service.
INGEST_INTERVAL_MINUTES=15

# --- Front (service web) ---
# Interface and port on the host. Default: local only. 0.0.0.0 exposes it on the network (then use HTTPS + COOKIE_SECURE).
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Interface of the API's own port 8000 (docs, curl, smoke --api-only). Keep 127.0.0.1: with TRUST_PROXY=true
# anyone reaching it could forge X-Forwarded-For and bypass the per-IP rate limits.
API_BIND=127.0.0.1

# --- Accounts (magic link) ---
# Public URL of the front end: login links are {APP_BASE_URL}/connexion?token=...
# http://localhost:8080 = service web du compose (5173 = `npm run dev` du front).
APP_BASE_URL=http://localhost:8080
# Set to true as soon as the API is served over HTTPS (anything but local development).
COOKIE_SECURE=false
# Session length in days / magic-link validity in minutes.
SESSION_TTL_DAYS=30
LOGIN_TOKEN_TTL_MINUTES=15
# Read the client IP from X-Forwarded-For. Only true behind a reverse proxy that sets it (compose default: true,
# the web service's nginx). Set false if the API is reached directly.
TRUST_PROXY=true
# "console": the login link is written in the API logs (development only). The API refuses to start with
# MAIL_BACKEND=console and COOKIE_SECURE=true, and logs a warning at startup whenever console is active.
# "smtp": send a real e-mail. For local testing with mailpit (docker compose --profile mail up):
#   MAIL_BACKEND=smtp SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_STARTTLS=false   (inbox: http://localhost:8025)
MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Citizen News <no-reply@localhost>
# Rate limits per window (seconds); 429 + Retry-After beyond. Counters are kept in memory, per API process.
# RATE_LIMIT_WINDOW_SECONDS=3600
# RATE_LIMIT_MAGIC_LINK_PER_EMAIL=5
# RATE_LIMIT_MAGIC_LINK_PER_IP=20
# RATE_LIMIT_VERIFY_PER_IP=30
# RATE_LIMIT_CLAIM_PER_ACCOUNT=30
# Maximum votes per POST /api/votes/claim (422 beyond).
# CLAIM_MAX_VOTES=200
# Votes: per account over a short window; 429 + Retry-After beyond.
# RATE_LIMIT_VOTE_PER_ACCOUNT=120
# RATE_LIMIT_VOTE_WINDOW_SECONDS=60
# Allows `python -m app.cli seed-demo` (fictional topics, accounts and votes). Development only.
DEMO_SEED=false
